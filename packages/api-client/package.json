{
  "name": "@document-intake/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generate": "rm -rf src/generated && orval --config ./orval.config.ts && node ./scripts/verify-generated.mjs",
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@testing-library/react": "16.3.2",
    "@types/powerapps-component-framework": "1.3.18",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "jsdom": "27.0.1",
    "msw": "2.15.0",
    "orval": "8.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
