{
  "name": "document-intake",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build && pnpm run check:bundle",
    "build:libs": "pnpm --filter @document-intake/api-client --filter @document-intake/ui --filter @document-intake/web run build",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "dev": "pnpm --filter @document-intake/web run dev",
    "storybook": "pnpm --filter @document-intake/ui run storybook",
    "test": "pnpm -r run test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:single-react-query": "node scripts/check-single-react-query.mjs",
    "typecheck": "pnpm -r run typecheck",
    "generate": "pnpm --filter @document-intake/api-client run generate",
    "verify:generate": "pnpm run generate && node scripts/check-git-clean.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "typescript": "5.9.3"
  }
}
