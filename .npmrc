# pcf-scripts runs a webpack build that cannot resolve pnpm's symlinked store
# layout, so this workspace installs a flat, hoisted node_modules instead.
node-linker=hoisted
shamefully-hoist=true

# Keep peer resolution strict everywhere else so a second copy of react or
# @tanstack/react-query cannot sneak into the control bundle.
auto-install-peers=true
strict-peer-dependencies=false
resolution-mode=highest
